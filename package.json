{
  "name": "deepseek-usage-monitor",
  "displayName": "DeepSeek Usage Monitor & Dashboard",
  "description": "%extension.description%",
  "version": "2.1.0",
  "publisher": "Muzyu",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muzyu123/DeepSeek_Usage_Monitor"
  },
  "bugs": {
    "url": "https://github.com/Muzyu123/DeepSeek_Usage_Monitor/issues"
  },
  "homepage": "https://github.com/Muzyu123/DeepSeek_Usage_Monitor#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deepseek",
    "usage",
    "token",
    "cost",
    "dashboard"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "DeepSeek Usage Monitor & Dashboard",
      "properties": {
        "deepseek-usage-monitor.sessionToken": {
          "type": "string",
          "default": "",
          "description": "%config.sessionToken.description%",
          "order": 2
        },
        "deepseek-usage-monitor.cookie": {
          "type": "string",
          "default": "",
          "description": "%config.cookie.description%",
          "order": 3
        },
        "deepseek-usage-monitor.proxy": {
          "type": "string",
          "default": "",
          "description": "%config.proxy.description%",
          "order": 4
        },
        "deepseek-usage-monitor.language": {
          "type": "string",
          "enum": [
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "English",
            "简体中文"
          ],
          "default": "zh-cn",
          "description": "%config.language.description%",
          "order": 5
        },
        "deepseek-usage-monitor.statusBar.items": {
          "type": "array",
          "default": [
            "todayCost",
            "balance"
          ],
          "items": {
            "type": "string",
            "enum": [
              "todayCost",
              "monthCost",
              "balance",
              "todayTokens"
            ]
          },
          "uniqueItems": true,
          "markdownDescription": "%config.statusBarItems.markdownDescription%",
          "order": 6
        },
        "deepseek-usage-monitor.statusBar.label": {
          "type": "string",
          "default": "DeepSeek Usage",
          "markdownDescription": "%config.statusBarLabel.markdownDescription%",
          "order": 7
        },
        "deepseek-usage-monitor.statusBar.closeWhenActive": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.statusBarCloseWhenActive.markdownDescription%",
          "order": 8
        },
        "deepseek-usage-monitor.refreshInterval": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "markdownDescription": "%config.refreshInterval.markdownDescription%",
          "order": 9
        },
        "deepseek-usage-monitor.dashboard.backgroundColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.dashboardBackgroundColor.markdownDescription%",
          "order": 10
        },
        "deepseek-usage-monitor.dashboard.backgroundDim": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 0.9,
          "markdownDescription": "%config.dashboardBackgroundDim.markdownDescription%",
          "order": 11
        },
        "deepseek-usage-monitor.dashboard.cardOpacity": {
          "type": "number",
          "default": 0.82,
          "minimum": 0.3,
          "maximum": 1,
          "markdownDescription": "%config.dashboardCardOpacity.markdownDescription%",
          "order": 12
        }
      }
    },
    "commands": [
      {
        "command": "deepseek-usage-monitor.showUsage",
        "title": "%command.openDashboard%"
      },
      {
        "command": "deepseek-usage-monitor.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "deepseek-usage-monitor.setApiKey",
        "title": "%command.setApiKey%"
      },
      {
        "command": "deepseek-usage-monitor.setDashboardBackground",
        "title": "%command.setDashboardBackground%"
      },
      {
        "command": "deepseek-usage-monitor.clearDashboardBackground",
        "title": "%command.clearDashboardBackground%"
      },
      {
        "command": "deepseek-usage-monitor.exportConfig",
        "title": "%command.exportConfig%"
      },
      {
        "command": "deepseek-usage-monitor.importConfig",
        "title": "%command.importConfig%"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
